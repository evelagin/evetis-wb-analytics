{
  "schema_version": 1,
  "comment": "Желаемая конфигурация Workload Identity Federation в Claude Console (AE_V1_SECURITY.md §7). НЕ ПРИМЕНЕНО: создаётся владельцем (роль admin/owner организации Anthropic) — AE_V1_RUNBOOK.md §2.4. Семантика матчинга — platform.claude.com/docs/en/manage-claude/workload-identity-federation (2026-09-24): subject_prefix — точное совпадение (префикс только с завершающим *), audience — точное, claims — точные значения, все заданные условия обязаны выполниться; правило выбирается клиентом ПО ID, неявного поиска нет. tools/tests/test_autonomy_anthropic_federation.py проверяет эти правила на точных claims GitHub.",
  "issuer": {
    "issuer_url": "https://token.actions.githubusercontent.com",
    "jwks_source": "discovery",
    "check_jti": true
  },
  "workspace": {
    "name": "evetis-ae",
    "purpose": "Отдельный workspace: лимит расходов и атрибуция использования только AE",
    "monthly_spend_limit_usd": 200
  },
  "service_accounts": {
    "engineer": {"name": "evetis-ae-engineer", "workspaces": ["evetis-ae"]},
    "reviewer": {"name": "evetis-ae-reviewer", "workspaces": ["evetis-ae"]}
  },
  "rules": {
    "engineer": {
      "name": "evetis-ae-engineer-main",
      "target_service_account": "engineer",
      "workspace": "evetis-ae",
      "oauth_scope": "workspace:developer",
      "token_lifetime_seconds": 600,
      "match": {
        "subject_prefix": "repo:evelagin/evetis-wb-analytics:ref:refs/heads/main",
        "audience": "https://api.anthropic.com",
        "claims": {
          "repository": "evelagin/evetis-wb-analytics",
          "repository_owner": "evelagin",
          "ref": "refs/heads/main",
          "event_name": "workflow_dispatch",
          "runner_environment": "github-hosted",
          "workflow_ref": "evelagin/evetis-wb-analytics/.github/workflows/autonomy-run.yml@refs/heads/main",
          "job_workflow_ref": "evelagin/evetis-wb-analytics/.github/workflows/autonomy-engineer.yml@refs/heads/main"
        }
      }
    },
    "reviewer": {
      "name": "evetis-ae-reviewer-main",
      "target_service_account": "reviewer",
      "workspace": "evetis-ae",
      "oauth_scope": "workspace:developer",
      "token_lifetime_seconds": 600,
      "match": {
        "subject_prefix": "repo:evelagin/evetis-wb-analytics:ref:refs/heads/main",
        "audience": "https://api.anthropic.com",
        "claims": {
          "repository": "evelagin/evetis-wb-analytics",
          "repository_owner": "evelagin",
          "ref": "refs/heads/main",
          "event_name": "workflow_dispatch",
          "runner_environment": "github-hosted",
          "workflow_ref": "evelagin/evetis-wb-analytics/.github/workflows/autonomy-run.yml@refs/heads/main",
          "job_workflow_ref": "evelagin/evetis-wb-analytics/.github/workflows/autonomy-review.yml@refs/heads/main"
        }
      }
    }
  },
  "github_variables": {
    "AE_ANTHROPIC_ORGANIZATION_ID": "UUID организации Anthropic",
    "AE_ANTHROPIC_WORKSPACE_ID": "wrkspc_… workspace evetis-ae",
    "AE_ANTHROPIC_FEDERATION_RULE_ID": "fdrl_… правила engineer",
    "AE_ANTHROPIC_SERVICE_ACCOUNT_ID": "svac_… аккаунта engineer",
    "AE_ANTHROPIC_REVIEWER_FEDERATION_RULE_ID": "fdrl_… правила reviewer",
    "AE_ANTHROPIC_REVIEWER_SERVICE_ACCOUNT_ID": "svac_… аккаунта reviewer"
  }
}
