    "native": "SELECT\n  norm_query,\n  product_name_short,\n  nm_id,\n  evidence_status,\n  spend_rub,\n  views_sum,\n  clicks_sum,\n  ctr,\n  cpc_calc,\n  atbs_sum,\n  cart_cr_clicks,\n  orders_sum,\n  order_cr_clicks,\n  cpo_ads,\n  avg_pos_w_clicks,\n  signals_text,\n  advert_count\nFROM `wb_mart.V_ADS_SCREEN_QUERY`\nWHERE window_days = {{window}}\n  [[AND {{sku}}]]\n  [[AND {{q}}]]\n  [[AND spend_rub >= {{spend_min}}]]\n  [[AND orders_sum >= {{orders_min}}]]\n  AND can_judge_order_cr AND orders_sum > 0\nORDER BY order_cr_vs_baseline DESC NULLS LAST, spend_rub DESC\n",
