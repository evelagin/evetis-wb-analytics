  "stages": [
   {
    "lib/type": "mbql.stage/native",
    "native": "SELECT\n  MAX(as_of_date)                                                  AS as_of_date,\n  COUNT(*)                                                         AS queries_cnt,\n  SUM(spend_rub)                                                   AS spend_rub,\n  SUM(views_sum)                                                   AS views,\n  SUM(clicks_sum)                                                  AS clicks,\n  SUM(atbs_sum)                                                    AS atbs,\n  SUM(orders_sum)                                                  AS orders_raw,\n  SUM(shks_sum)                                                    AS buyouts_raw,\n  SAFE_DIVIDE(SUM(clicks_on_imp), SUM(views_sum))                  AS ctr,\n  SAFE_DIVIDE(SUM(spend_rub), SUM(clicks_sum))                     AS cpc_rub,\n  SAFE_DIVIDE(SUM(atbs_sum), SUM(clicks_sum))                      AS cart_cr,\n  SAFE_DIVIDE(SUM(orders_sum), SUM(clicks_sum))                    AS order_cr,\n  SAFE_DIVIDE(SUM(spend_rub), NULLIF(SUM(orders_sum), 0))          AS cpo_rub,\n  SAFE_DIVIDE(SUM(avg_pos_w_clicks * clicks_sum), SUM(clicks_sum)) AS avg_paid_pos\nFROM `wb_mart.V_ADS_SCREEN_QUERY`\nWHERE window_days = {{window}}\n  [[AND {{sku}}]]\n  [[AND {{evidence}}]]\n  [[AND {{q}}]]\n  [[AND spend_rub >= {{spend_min}}]]\n  [[AND orders_sum >= {{orders_min}}]]\n",
