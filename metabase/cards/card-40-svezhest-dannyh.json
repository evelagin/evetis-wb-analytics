    "native": "SELECT\n  FORMAT_DATE('%d.%m.%Y', data_as_of_min)                          AS data_as_of,\n  FORMAT_TIMESTAMP('%d.%m %H:%M', mart_built_at, 'Europe/Moscow')  AS mart_built,\n  CONCAT(CAST(layers_ok AS STRING), '/', CAST(layers_total AS STRING)) AS layers_ok\nFROM `wb_mart.V_DASH_FRESHNESS_HEADER`"
