  "stages": [
   {
    "lib/type": "mbql.stage/native",
    "native": "SELECT\n  evidence_status,\n  COUNT(*)                                                        AS queries_cnt,\n  SAFE_DIVIDE(COUNT(*), SUM(COUNT(*)) OVER ())                    AS queries_share,\n  SUM(spend_rub)                                                  AS spend_rub,\n  SAFE_DIVIDE(SUM(spend_rub), SUM(SUM(spend_rub)) OVER ())        AS spend_share,\n  SUM(clicks_sum)                                                 AS clicks,\n  SUM(views_sum)                                                  AS views,\n  SUM(orders_sum)                                                 AS orders_raw,\n  COUNTIF(can_compare_ctr)                                        AS can_ctr,\n  COUNTIF(can_compare_cpc)                                        AS can_cpc,\n  COUNTIF(can_judge_order_cr)                                     AS can_order_cr\nFROM `wb_mart.V_ADS_SCREEN_QUERY`\nWHERE window_days = {{window}}\n  [[AND {{sku}}]]\n  [[AND {{q}}]]\n  [[AND spend_rub >= {{spend_min}}]]\n  [[AND orders_sum >= {{orders_min}}]]\nGROUP BY evidence_status\nORDER BY CASE evidence_status\n           WHEN \"ACTIONABLE\"    THEN 1\n           WHEN \"OBSERVATIONAL\" THEN 2\n           ELSE 3\n         END\n",
