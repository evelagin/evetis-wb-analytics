    "lib/type": "mbql.stage/native",
    "native": "WITH f AS (\n  SELECT day FROM `wb_mart.V_DASH_FINANCE_CORRECTED_DAILY`\n  WHERE {{day}}\n)\nSELECT\n  e.day,\n  e.sales_revenue_seller_base_rub AS revenue_rub,\n  IF(e.after_product_cogs_eligible, e.period_result_after_product_cogs_rub, NULL) AS result_after_cogs_rub\nFROM f JOIN `wb_mart.V_DASH_EXECUTIVE_ECONOMICS_DAILY` e USING (day)\nORDER BY e.day",
