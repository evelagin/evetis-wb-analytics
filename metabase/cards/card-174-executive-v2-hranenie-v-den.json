    "lib/type": "mbql.stage/native",
    "native": "-- SUM(storage_rub) / COUNTIF(period_result_eligible)\nWITH d AS (SELECT day FROM `wb_mart.V_DASH_KPI_DAILY` WHERE {{day}})\nSELECT CONCAT('≈', REPLACE(FORMAT('%.2f', SAFE_DIVIDE(SUM(IF(e.period_result_eligible, k.storage_rub, NULL)), COUNTIF(e.period_result_eligible))), '.', ','),\n              ' ₽') AS storage_per_day,\n       CAST(COUNTIF(e.period_result_eligible) AS STRING) AS days\nFROM d JOIN `wb_mart.V_DASH_EXECUTIVE_ECONOMICS_DAILY` e USING (day) JOIN `wb_mart.V_DASH_KPI_DAILY` k USING (day)",
