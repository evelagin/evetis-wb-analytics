    "lib/type": "mbql.stage/native",
    "native": "SELECT\n  CONCAT(\n    FORMAT_DATE('%d.%m.%Y', MIN(day)), ' — ', FORMAT_DATE('%d.%m.%Y', MAX(day)),\n    IF(COUNTIF(is_current_day) > 0, ' (вкл. неполный сегодня)', '')\n  )                                                                       AS period,\n  CONCAT(CAST(COUNTIF(contribution_covered) AS STRING), '/', CAST(COUNT(*) AS STRING)) AS finance_days,\n  COUNTIF(contains_provisional_finance)                                   AS provisional_days\nFROM `wb_mart.V_DASH_KPI_DAILY`\nWHERE {{day}}",
