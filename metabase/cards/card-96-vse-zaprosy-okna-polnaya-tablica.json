    "native": "SELECT\n  norm_query,\n  product_name_short,\n  nm_id,\n  internal_sku,\n  evidence_status,\n  evidence_reason,\n  signals_text,\n  signal_top,\n  spend_rub,\n  spend_share_of_sku,\n  spend_share_window,\n  views_sum,\n  clicks_sum,\n  ctr,\n  cpc_calc,\n  cpm_calc,\n  atbs_sum,\n  cart_cr_clicks,\n  orders_sum,\n  order_cr_clicks,\n  order_cr_carts,\n  shks_sum,\n  buyout_ratio_shk,\n  cpo_ads,\n  avg_pos_w_clicks,\n  avg_pos_w_views,\n  baseline_level,\n  baseline_ctr,\n  ctr_vs_baseline,\n  baseline_cpc,\n  cpc_vs_baseline,\n  baseline_order_cr,\n  order_cr_vs_baseline,\n  baseline_cpo,\n  cpo_vs_baseline,\n  can_compare_ctr,\n  can_compare_cpc,\n  can_judge_cart_cr,\n  can_judge_order_cr,\n  can_judge_order_carts,\n  funnel_monotonic,\n  days_with_data,\n  days_with_spend,\n  advert_count,\n  bid_min,\n  bid_max,\n  bid_is_uniform,\n  bid_snapshot_date,\n  bid_snapshot_offset_days,\n  delta_cpc,\n  delta_order_cr_clicks,\n  delta_spend,\n  as_of_date,\n  window_days\nFROM `wb_mart.V_ADS_SCREEN_QUERY`\nWHERE window_days = {{window}}\n  [[AND {{sku}}]]\n  [[AND {{evidence}}]]\n  [[AND {{q}}]]\n  [[AND spend_rub >= {{spend_min}}]]\n  [[AND orders_sum >= {{orders_min}}]]\nORDER BY spend_rub DESC\n",
