    "lib/type": "mbql.stage/native",
    "native": "-- Статус данных Executive: V_DASH_EXECUTIVE_ECONOMICS_DAILY.executive_*_day\nWITH d AS (SELECT day FROM `wb_mart.V_DASH_KPI_DAILY` WHERE {{day}})\nSELECT CASE\n  WHEN SUM(e.executive_incomplete_day) > 0  THEN '🔴 НЕПОЛНЫЕ ДАННЫЕ'\n  WHEN SUM(e.executive_provisional_day) > 0 THEN '🟡 ПРЕДВАРИТЕЛЬНЫЕ ДАННЫЕ'\n  ELSE '🟢 ОКОНЧАТЕЛЬНЫЕ ДАННЫЕ' END AS data_status\nFROM d JOIN `wb_mart.V_DASH_EXECUTIVE_ECONOMICS_DAILY` e USING (day)",
