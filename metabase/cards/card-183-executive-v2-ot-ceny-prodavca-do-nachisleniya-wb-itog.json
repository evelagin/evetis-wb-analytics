    "lib/type": "mbql.stage/native",
    "native": "-- settlement_seller_price_rub − settlement_goods_rub; settlement_price_chain_covered\nWITH d AS (SELECT day FROM `wb_mart.V_DASH_KPI_DAILY` WHERE {{day}})\nSELECT\n  CONCAT(IF(ROUND(-(SUM(s.settlement_seller_price_rub) - SUM(s.settlement_goods_rub))) < 0, '-', ''), REPLACE(FORMAT(\"%'d\", ABS(CAST(ROUND(-(SUM(s.settlement_seller_price_rub) - SUM(s.settlement_goods_rub))) AS INT64))), ',', ' '), ' ₽') AS withheld_from_price,\n  CONCAT(CAST(COUNTIF(s.settlement_price_chain_covered) AS STRING), ' из ', CAST(COUNT(*) AS STRING), ' сут.') AS closed_days\nFROM d LEFT JOIN `wb_mart.V_DASH_SETTLEMENT_DAILY` s USING (day)",
