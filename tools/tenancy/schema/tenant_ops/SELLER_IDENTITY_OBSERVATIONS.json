    {
      "description": "client_id Performance API (идентификатор, не секрет)",
      "mode": "NULLABLE",
      "name": "performance_client_id",
      "type": "STRING"
    },
    {
      "description": "ИНН из /v1/seller/info",
      "mode": "NULLABLE",
      "name": "company_inn",
      "type": "STRING"
    },
    {
      "description": "ОГРН из /v1/seller/info",
      "mode": "NULLABLE",
      "name": "company_ogrn",
      "type": "STRING"
    },
    {
      "description": "Название из /v1/seller/info",
      "mode": "NULLABLE",
      "name": "company_name",
      "type": "STRING"
    },
    {
      "description": "Юрлицо из /v1/seller/info",
      "mode": "NULLABLE",
      "name": "legal_name",
