{
  "clustering": [
    "entity",
    "status"
  ],
  "schema": [
    {
      "description": "Идентификатор backfill",
      "mode": "REQUIRED",
      "name": "backfill_id",
      "type": "STRING"
    },
    {
      "description": "Сущность",
      "mode": "REQUIRED",
      "name": "entity",
      "type": "STRING"
    },
    {
      "description": "Начало окна",
      "mode": "REQUIRED",
      "name": "window_from",
      "type": "DATE"
    },
    {
      "description": "Конец окна (включительно)",
      "mode": "REQUIRED",
      "name": "window_to",
      "type": "DATE"
    },
    {
      "description": "PENDING, RUNNING, DONE, FAILED, REOPENED (только оператор); FAILED_PERMANENT — вывод свёртки, не пишется",
      "mode": "REQUIRED",
      "name": "status",
      "type": "STRING"
    },
    {
      "description": "Число попыток",
      "mode": "REQUIRED",
      "name": "attempts",
      "type": "INTEGER"
    },
    {
      "description": "Записано строк",
      "mode": "NULLABLE",
      "name": "rows_written",
      "type": "INTEGER"
    },
    {
      "description": "Прогон runtime",
      "mode": "NULLABLE",
      "name": "run_id",
      "type": "STRING"
    },
    {
      "description": "Код ошибки",
      "mode": "NULLABLE",
      "name": "error_code",
      "type": "STRING"
    },
    {
      "description": "Описание без секретов",
      "mode": "NULLABLE",
      "name": "error_detail",
      "type": "STRING"
    },
    {
      "description": "Время обновления",
      "mode": "REQUIRED",
      "name": "updated_at",
      "type": "TIMESTAMP"
    },
    {
      "description": "T5: хеш плана бэкфилла (checkpoints.plan_hash), подтверждённого оператором",
      "mode": "NULLABLE",
      "name": "plan_hash",
      "type": "STRING"
    },
    {
      "description": "T5: прогон control, взявший аренду отрезка",
      "mode": "NULLABLE",
      "name": "lease_owner",
      "type": "STRING"
    },
    {
      "description": "T5: срок аренды (таблица tenant_locks.L_<chunk>_<поколение> истекает тогда же)",
      "mode": "NULLABLE",
      "name": "lease_until",
      "type": "TIMESTAMP"
    },
    {
      "description": "T5: поколение аренды; перехват истёкшей — следующее поколение",
      "mode": "NULLABLE",
      "name": "lease_generation",
      "type": "INTEGER"
    },
    {
      "description": "T5: начало попытки (аренда взята)",
      "mode": "NULLABLE",
      "name": "started_at",
      "type": "TIMESTAMP"
    },
    {
      "description": "T5: подтверждение DONE по журналу прогонов runtime",
      "mode": "NULLABLE",
      "name": "completed_at",
      "type": "TIMESTAMP"
    },
    {
      "description": "T5: доказательства версии (выгрузки Performance на отрезок и т. п.), без identity и секретов",
      "mode": "NULLABLE",
      "name": "evidence_json",
      "type": "STRING"
    }
  ],
  "table_id": "BACKFILL_CHECKPOINTS",
  "time_partitioning": {
    "field": "updated_at",
    "type": "DAY"
  }
}
