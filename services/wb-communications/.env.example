# ============================================================================
# EVETIS WB Communications — example configuration.
# Copy to `.env` for LOCAL DEV only. NEVER put real secret VALUES in a committed
# file. In Cloud Run these secrets come from Secret Manager, not from env.
# ============================================================================

# --- GCP ---
GCP_PROJECT_ID=project-fa311fc0-4d87-4781-986
GCP_REGION=europe-west1
FIRESTORE_DATABASE=(default)
# Firestore location is its OWN value — NOT the BigQuery "EU" multi-region.
FIRESTORE_LOCATION=eur3
BIGQUERY_LOCATION=EU
BIGQUERY_DATASET=evetis_communications
BIGQUERY_CURRENT_TABLE=communications_current
BIGQUERY_EVENTS_TABLE=communication_events
# Separate table for Communication Engine v2 shadow rows (never mixed with
# publication history above).
BIGQUERY_SHADOW_TABLE=communication_engine_shadow
FIRESTORE_COLLECTION=communications

# --- OpenAI ---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=600
PROMPT_VERSION=reviews_v1
PROMPTS_DIR=prompts

# --- Communication Engine v2 (shadow) ---
# OFF by default. When false the v2 engine is never constructed or called and the
# service behaves EXACTLY as before. Turn on only to start shadow observation.
COMMUNICATION_ENGINE_V2_ENABLED=false
# When true (default), v2 runs strictly in shadow: it records a comparison row and
# never influences the published answer or moderation. v2 has NO WB-publish path.
COMMUNICATION_ENGINE_V2_SHADOW_ONLY=true
# When true (requires _ENABLED=true), v2 becomes the PRIMARY draft generator
# (verified KB + validators) instead of reviews_v1. Still human-approved.
COMMUNICATION_ENGINE_V2_PRIMARY=false

# --- Wildberries ---
WB_API_BASE_URL=https://feedbacks-api.wildberries.ru
WB_POLL_BATCH_SIZE=30
WB_MAX_PAGES=20
WB_MAX_ITEMS=500
# FAIL-CLOSED: real WB publishing stays OFF until you confirm the endpoint on
# the live Swagger and explicitly set this to "true".
WB_PUBLISH_ENABLED=false
# On recovery of a crashed publish lease, refuse to blindly re-publish and ask
# for manual WB verification (WB PATCH idempotency not yet confirmed).
WB_VERIFY_BEFORE_PUBLISH=true
# Publish contract — confirm against live Swagger before first real publish.
# First answer to a feedback = POST /api/v1/feedbacks/answer (edit = PATCH same path).
WB_ANSWER_METHOD=POST
WB_ANSWER_PATH=/api/v1/feedbacks/answer
WB_FEEDBACKS_PATH=/api/v1/feedbacks

# --- WB questions (separate entity, own gates) ---
WB_QUESTIONS_ENABLED=false
WB_QUESTION_PUBLISH_ENABLED=false
WB_QUESTIONS_PATH=/api/v1/questions
WB_QUESTION_ANSWER_METHOD=PATCH
WB_QUESTION_ANSWER_STATE=wbRu
WB_QUESTIONS_FIRST_RUN_MAX=20
WB_MIN_INTERVAL_SECONDS=0.6

# --- Telegram ---
TELEGRAM_CHAT_ID=302044578
TELEGRAM_ALLOWED_USER_IDS=302044578
TELEGRAM_WEBHOOK_URL=
TELEGRAM_EDIT_TIMEOUT_SECONDS=900

# --- Concurrency / recovery ---
LOCK_LEASE_SECONDS=300
UPDATE_LEASE_SECONDS=120
OUTBOX_LEASE_SECONDS=60

# --- Ops ---
LOG_LEVEL=INFO
ENVIRONMENT=production
# Optional extra guard for /admin/* endpoints (leave empty to rely on Cloud Run IAM only)
ADMIN_TOKEN=
SHEETS_JOURNAL_ENABLED=false

# --- Secrets: LOCAL DEV ONLY (placeholders). In prod they live in Secret Manager. ---
# EVETIS_OPENAI_API_KEY=sk-REPLACE_ME
# EVETIS_WB_API_TOKEN=REPLACE_ME
# EVETIS_TELEGRAM_BOT_TOKEN=REPLACE_ME
# EVETIS_TELEGRAM_WEBHOOK_SECRET=REPLACE_ME
# EVETIS_SCHEDULER_SECRET=REPLACE_ME
