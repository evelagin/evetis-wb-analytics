# ---------------------------------------------------------------------------
# Ozon audit 2026-08-30 — сырьё и заготовки загрузки вне Git.
# Правило: Git хранит решения и код, данные живут в GCS/BigQuery.
# Восстанавливается загрузчиками из Ozon API; происхождение — в MANIFEST.csv.
# ---------------------------------------------------------------------------
docs/ozon/audit_*/raw/**
docs/ozon/audit_*/load/**

# Исключения: опись доказательств и production-годный код остаются в Git.
# Шаблон по маске, а не перечислением: перечисление уже один раз потеряло
# _bf_sku_spend_boundary.py — новый скрипт молча выпадал из репозитория.
!docs/ozon/audit_*/raw/**/
!docs/ozon/audit_*/raw/MANIFEST.csv
!docs/ozon/audit_*/raw/*.py
!docs/ozon/audit_*/raw/backfill_v1/*.py
# ...но не кэш и не сырьё, даже если оно .py-соседствует
docs/ozon/audit_*/raw/**/__pycache__/

# Юридические документы по спору с РВБ — на диске, но не в репозитории аналитики
docs/legal/

# Python
__pycache__/
*.pyc

# Локальные настройки Claude Code — у каждой машины свои
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Сгенерированные аналитические книги и одноразовые выгрузки.
# Решение фиксируется в .md рядом; книга пересобирается и в Git не хранится.
# Файлы остаются на диске — правило не удаляет их, а лишь не версионирует.
# ---------------------------------------------------------------------------
docs/**/*.xlsx
docs/**/*.xls
# Исключение: официальные тарифные документы Ozon — первичное доказательство,
# архивную редакцию повторно скачать уже нельзя.
!docs/ozon/audit_*/tariffs/source/*.xlsx
# Исключение: книга уже versioned до введения правила — не разворачиваем историю.
!docs/ozon/ozon_posle_28.08.xlsx

# Рабочая папка выгрузок ассистента — не часть репозитория
Claude outputs/

# Операционные ТЗ фулфилменту (USEND) — партнёрские документы, не аналитика
docs/tz_ozon_*/

# STEP 5C — clasp credentials НИКОГДА не попадают в репозиторий.
# .clasp.json (scriptId+rootDir) и .claspignore — конфигурация, они tracked намеренно.
.clasprc.json
**/.clasprc.json
.clasp-auth/
clasp-credentials*.json

# Артефакты прогонов Definition of Done: доказательства конкретного прогона,
# содержат значения данных и не версионируются (docs/architecture/REPOSITORY_DATA_POLICY.md).
artifacts/

# Закрытая документация ЦРПТ (True API, СУЗ) — не публиковать
docs/chz/vendor/
